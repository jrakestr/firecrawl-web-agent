# Required
FIRECRAWL_API_KEY=

# Provider API keys (users can override via BYOK in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# MLB Predictions dashboard (Supabase project gwvtpzjzrakggdbiwlyw)
# Use new API keys (sb_publishable_... / sb_secret_...), not legacy anon/service_role JWTs.
# Dashboard: https://supabase.com/dashboard/project/gwvtpzjzrakggdbiwlyw/settings/api-keys
SUPABASE_URL=https://gwvtpzjzrakggdbiwlyw.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://gwvtpzjzrakggdbiwlyw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Optional fallback for schedulers that still send Bearer CRON_SECRET
